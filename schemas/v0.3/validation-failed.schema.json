{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yaagents.io/schemas/v0.3/validation-failed.schema.json",
  "title": "Validation Failed",
  "description": "Body for application/vnd.yaagents.validation-error+json (HTTP 422). The request inputs failed validation.",
  "type": "object",
  "required": ["type", "code", "message", "trace"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "validation_failed",
      "description": "Discriminator identifying this response type."
    },
    "code": {
      "type": "string",
      "const": "VALIDATION_FAILED",
      "description": "Machine-readable error code."
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of the validation failure."
    },
    "errors": {
      "type": "array",
      "description": "Field-level validation error details.",
      "items": {
        "$ref": "#/definitions/fieldError"
      }
    },
    "trace": {
      "$ref": "#/definitions/trace"
    }
  },
  "definitions": {
    "trace": {
      "type": "object",
      "description": "Correlation identifiers propagated from the inbound request.",
      "required": ["correlationId", "requestId"],
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "description": "Cross-service correlation identifier (X-Correlation-ID header)."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "description": "Per-request unique identifier (X-Request-ID header)."
        }
      }
    },
    "fieldError": {
      "type": "object",
      "description": "A single field-level validation error.",
      "required": ["field", "message"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "JSON path or field name that failed validation."
        },
        "message": {
          "type": "string",
          "description": "Human-readable description of why the field is invalid."
        }
      }
    }
  }
}
