{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yaagents.io/schemas/v0.3/operation-accepted.schema.json",
  "title": "Operation Accepted",
  "description": "Body for application/vnd.yaagents.operation+json (HTTP 202). The operation was accepted for asynchronous processing.",
  "type": "object",
  "required": ["type", "code", "message", "operationId", "statusUrl", "trace"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "operation_accepted",
      "description": "Discriminator identifying this response type."
    },
    "code": {
      "type": "string",
      "const": "OPERATION_ACCEPTED",
      "description": "Machine-readable code confirming acceptance."
    },
    "message": {
      "type": "string",
      "description": "Human-readable description confirming the operation was accepted."
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for the accepted asynchronous operation."
    },
    "statusUrl": {
      "type": "string",
      "description": "URL to poll for operation status (relative or absolute URI)."
    },
    "trace": {
      "$ref": "#/definitions/trace"
    }
  },
  "definitions": {
    "trace": {
      "type": "object",
      "description": "Correlation identifiers propagated from the inbound request.",
      "required": ["correlationId", "requestId"],
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "description": "Cross-service correlation identifier (X-Correlation-ID header)."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "description": "Per-request unique identifier (X-Request-ID header)."
        }
      }
    }
  }
}
