{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yaagents.io/schemas/v0.3/agentic-error.schema.json",
  "title": "Agentic Error",
  "description": "Body for application/vnd.yaagents.error+json (HTTP 403 forbidden / 424 failed_dependency / 500 error). Generic agentic error shape shared by three response types.",
  "type": "object",
  "required": ["type", "code", "message", "trace"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["forbidden", "failed_dependency", "error"],
      "description": "Discriminator identifying the specific error sub-type."
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "Service-specific error code (e.g. PERMISSION_DENIED, UPSTREAM_UNAVAILABLE)."
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of the error."
    },
    "retryAfter": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds the client should wait before retrying (used on 429 limit-exceeded responses)."
    },
    "trace": {
      "$ref": "#/definitions/trace"
    }
  },
  "definitions": {
    "trace": {
      "type": "object",
      "description": "Correlation identifiers propagated from the inbound request.",
      "required": ["correlationId", "requestId"],
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "description": "Cross-service correlation identifier (X-Correlation-ID header)."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "description": "Per-request unique identifier (X-Request-ID header)."
        }
      }
    }
  }
}
