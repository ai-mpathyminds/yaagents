# yaagents/cli — Python CLI (uv-managed)
# uv.lock convention: yaagents does NOT track lockfiles for any Python package
# (verified 2026-06-01 across cli/, sdk-fastapi/, client-python/ — zero sibling
# uv.lock files tracked). Match the convention here.
uv.lock

# Standard Python build/test residue
__pycache__/
*.pyc
*.pyo
.coverage
.coverage.*
htmlcov/
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
*.egg-info/
.venv/
